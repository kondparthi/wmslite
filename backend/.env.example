# Production (MySQL) — copy this file to .env and fill in real credentials.
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=mysql+pymysql://wms_user:CHANGE_ME@localhost:3306/wms_lite

# Comma-separated list of frontend origins allowed to call this API.
CORS_ORIGINS=https://wms.delaplex.digital,http://localhost:5173,http://localhost:5183

# --- Local dev/test without MySQL ---
# Leave DATABASE_URL unset (or comment it out) to fall back automatically to
# a local SQLite file (./wms_lite_dev.db) — useful for running/testing this
# API without a MySQL server available.

# --- Auth ---
# Set a real random secret in production — anyone who knows this can forge
# login tokens. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-random-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# On first run (empty users table), one login is auto-created so you can
# sign in immediately. Change the password after first login, or set your
# own values here before the first run.
DEFAULT_TENANT_ID=DELAPLEX-WH01
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@delaplex.digital
DEFAULT_ADMIN_PASSWORD=Admin@123

# --- Remember Me / password reset ---
REMEMBER_ME_EXPIRE_DAYS=30
RESET_CODE_EXPIRE_MINUTES=10

# --- Outgoing email (password-reset codes) ---
# Leave SMTP_HOST empty and no email is sent: the code is written to the
# backend log instead (journalctl -u wms-backend -n 30). Fill these in with
# a real mailbox to send codes by email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=false
